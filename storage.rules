rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Prompt images — public read, NO client writes
    // (uploads happen via Cloud Functions with admin SDK)
    match /prompt-images/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Prompt videos — public read, NO client writes
    match /prompt-videos/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // Admin uploads from the web panel — admin-only write
    match /prompts/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email == 'shaheelsaha55@gmail.com';
    }
  }
}
